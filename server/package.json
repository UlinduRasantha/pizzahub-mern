{
  "name": "pizzahub-server",
  "version": "1.0.0",
  "description": "PizzaHub REST API \u2014 Node.js + Express + MongoDB + Clerk",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node api/index.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src --ext .js",
    "seed": "node seed.js",
    "vercel-build": "echo \"No build step needed\""
  },
  "dependencies": {
    "@clerk/express": "^1.3.0",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.3.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "stripe": "^15.12.0",
    "svix": "^1.21.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}